<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="ViewEngineExtensions.fs" />
    <Compile Include="Extensions.fs" />
    <Compile Include="Global.fs" />
	<Folder Include="Services\" />
	<Compile Include="services\Content.fs" />
    <Compile Include="Services\UI.fs" />
    <Compile Include="services\Post.fs" />
    <Folder Include="Components\" />
    <Compile Include="components\Head.fs" />
    <Compile Include="components\Main.fs" />
    <Compile Include="components\Side.fs" />
    <Compile Include="components\Top.fs" />
	<Compile Include="Index.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
	<PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
	<PackageReference Include="Giraffe.ViewEngine" Version="1.4.0" />
  </ItemGroup>
</Project>
